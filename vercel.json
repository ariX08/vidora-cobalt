{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web",
      "framework": "sveltekit-1"
    },
    "api": {
      "root": ".",
      "runtime": "container"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "api",
        "path": "/"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api",
        "path": "/$1"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
